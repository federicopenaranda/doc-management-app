NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/dms
# Min 32 characters. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
GCS_BUCKET=
# Comma-separated list of allowed CORS origins (scheme + host + port, no trailing slash)
FRONTEND_URLS=http://localhost:4200
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Document worker (feature flag). When true, the four settings below are required.
DOCUMENT_PROCESSING_ENABLED=false
