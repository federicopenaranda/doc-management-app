NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/dms
# Min 32 characters. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
GCS_BUCKET=
# Comma-separated list of allowed CORS origins (scheme + host + port, no trailing slash)
FRONTEND_URLS=http://localhost:4200
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Document worker (all four are required)
TIKA_URL=
PROCESSED_BUCKET=
BACKEND_URL=
PUBSUB_PUSH_SA_EMAIL=
# Database connection and GET /health/database (feature flag). With CLOUD_SQL_INSTANCE set the backend
# connects through the Cloud SQL connector with IAM login (DB_NAME and DB_USER are then required);
# otherwise it uses DATABASE_URL.
DATABASE_ENABLED=false
# CLOUD_SQL_INSTANCE=my-project:us-west1:dms-postgres
# DB_NAME=dms
# DB_USER=backend-run@my-project.iam
# Login (POST /auth/login) and JWT authentication (feature flag). Needs DATABASE_ENABLED=true and a users
# table (see infrastructure/README.md). Tokens are signed with JWT_SECRET and last one hour.
AUTH_ENABLED=false
